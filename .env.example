# Copie para .env e preencha. O .env real nao vai para o git.

# Chrome sem janela. Deixe true em servidor.
HEADLESS_MODE=true

# Forca a versao do ChromeDriver. Em geral nao precisa: a versao do Chrome
# instalado e detectada em tempo de execucao.
CHROME_VERSION_MAIN=

# Notificacoes por e-mail (Gmail + App Password em myaccount.google.com/security)
EMAIL_USER=
EMAIL_PASS=

# Google Gemini, para os resumos por IA
GEMINI_API_KEY=
